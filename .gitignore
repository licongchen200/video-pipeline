# Generated output and caches — all reproducible from script.yaml
build/
out/
script.draft.yaml
__pycache__/

# Cloned upstream model repos + their checkpoints (~2.7GB), fetched by
# `make avatar-setup` / `make avatar-setup-sadtalker`
vendor/

# Virtualenvs, created by `make setup` / the avatar setup targets (~1.4GB)
.venv/
.avatar-venv/
.sadtalker-venv/

# Kokoro TTS weights (~350MB), fetched by `make setup`
models/

# Only needed for `make draft`; .env.example is the tracked template
.env

# Face photos are personal — never publish someone's likeness. Bring your own.
assets/

.DS_Store
