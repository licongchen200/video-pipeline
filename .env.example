# Only needed for `make draft` (topic -> draft script.yaml via an LLM).
# Every other stage runs fully local and needs no key at all.
#
#   cp .env.example .env    # then fill in your key
#
# The environment takes precedence over this file, so this also works:
#   OPENROUTER_API_KEY=sk-or-... make draft TOPIC="..."

OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-sonnet-5   # optional override
